#!/bin/sh
# Runs fleetd and `tailscale serve` in the foreground. Ctrl-C (or either one
# exiting) stops both, and the serve config goes with the tailscale process,
# so nothing is left listening or installed.
#
#   fleet-up -name mac1 -url https://mac1.your-tailnet.ts.net -owner you@github [fleetd flags]
#
#   FLEET_PORT   loopback port (default 7433)
#   FLEET_SERVE  0 to skip `tailscale serve` (loopback only)
set -eu
here=$(cd "$(dirname "$0")" && pwd -P)
port=${FLEET_PORT:-7433}
fpid='' spid=''
stop() {
  trap - INT TERM EXIT
  for p in $spid $fpid; do kill -TERM "$p" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap 'stop; exit 130' INT
trap 'stop; exit 143' TERM
trap stop EXIT
"$here/fleetd-run" -listen "127.0.0.1:$port" "$@" &
fpid=$!
if [ "${FLEET_SERVE:-1}" != 0 ]; then
  tailscale serve --https=443 "http://127.0.0.1:$port" &
  spid=$!
fi
while kill -0 "$fpid" 2>/dev/null && { [ -z "$spid" ] || kill -0 "$spid" 2>/dev/null; }; do
  sleep 1
done
echo "fleet-up: $(kill -0 "$fpid" 2>/dev/null && echo 'tailscale serve' || echo fleetd) exited; stopping" >&2
exit 1
