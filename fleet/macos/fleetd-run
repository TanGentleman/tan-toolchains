#!/bin/sh
# Starts fleetd with the env file loaded and PATH set so `container`,
# `tailscale` and Homebrew tools are found (launchd starts with an almost
# empty environment).
#
#   FLEET_ENV  env file (default ~/.config/fleet/env); "-" for none, as
#              `pic serve` sets: pi-ctr needs no key in fleetd
#   FLEETD     fleetd binary (default ~/.local/bin/fleetd)
#   FLEET_LOG  if set, append stdout and stderr here, moving it to .1 first
#              once it passes FLEET_LOG_MAX bytes (default 10 MB)
set -eu
if [ -n "${FLEET_LOG:-}" ]; then
  if [ -f "$FLEET_LOG" ] && [ "$(wc -c <"$FLEET_LOG")" -gt "${FLEET_LOG_MAX:-10485760}" ]; then
    mv -f "$FLEET_LOG" "$FLEET_LOG.1"
  fi
  exec >>"$FLEET_LOG" 2>&1
fi
env=${FLEET_ENV:-$HOME/.config/fleet/env}
if [ "$env" != - ]; then
  if [ ! -r "$env" ]; then
    echo "fleetd-run: $env is missing or unreadable; set FLEET_ENV=- for none" >&2
    exit 1
  fi
  set -a
  . "$env"
  set +a
fi
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export PATH
exec "${FLEETD:-$HOME/.local/bin/fleetd}" "$@"
